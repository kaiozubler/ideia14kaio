    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "core-relaunch",
      "version": "1.0.0",
      "title": "Core Relaunch"
    },
    "tools": [
      {
        "name": "list_appointments",
