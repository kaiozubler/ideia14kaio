{
  "manifest_version": 3,
  "name": "MediCopilot — Assistente IA",
  "version": "1.0.0",
  "description": "Assistente clínico do MediCopilot: analisa os dados da tela e conversa com o assistente de IA do seu app.",
  "permissions": ["storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Assistente MediCopilot",
    "default_icon": { "48": "icon.png", "128": "icon.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "48": "icon.png", "128": "icon.png" }
}